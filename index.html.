<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Akmal - Personal Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #0b0b16;
            color: white;
            font-family: Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .card {
            background: #19192b;
            padding: 45px 30px;
            border-radius: 20px;
            text-align: center;
            max-width: 500px;
            width: 100%;
            border: 1px solid #383052;
        }

        h1 {
            color: #b99aff;
            font-size: 38px;
            margin-bottom: 15px;
        }

        p {
            color: #c5c5d5;
            line-height: 1.8;
        }

        .button {
            display: inline-block;
            margin-top: 25px;
            padding: 12px 25px;
            background: #9370db;
            color: white;
            text-decoration: none;
            border-radius: 10px;
        }

        footer {
            margin-top: 35px;
            font-size: 12px;
            color: #888;
        }
    </style>
</head>

<body>
    <div class="card">
        <h1>HELLO, I'M AKMAL</h1>

        <p>Welcome to my personal website!</p>

        <p>
            This is my own little corner
            of the internet.
        </p>

        <a class="button" href="mailto:">
            Contact Me
        </a>

        <footer>
            © 2026 Akmal-X.4
        </footer>
    </div>
</body>
</html>
